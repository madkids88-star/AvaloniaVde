root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,axaml}]
charset = utf-8-bom
indent_size = 4

[*.{csproj,slnx,props,targets,json}]
charset = utf-8
indent_size = 2

[*.md]
charset = utf-8

[*.{axaml,cs}]
indent_size = 4
