<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaVde.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaVde.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="Button.TopBarButton">
            <Setter Property="Background" Value="#306060" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="#F5F5F5">
        <Grid Grid.Row="0"
              Height="50"
              Background="{StaticResource BrandBrush}"
              ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
            <Button Grid.Column="0"
                    Classes="TopBarButton"
                    Content="☰"
                    Command="{Binding BackCommand}"
                    Margin="8,0" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Title}"
                       Foreground="White"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Margin="4,0,16,0" />
            <TextBlock Grid.Column="2"
                       Text="Весы"
                       Foreground="White"
                       FontSize="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
            <Button Grid.Column="3"
                    Classes="TopBarButton"
                    Content="{Binding UserName}"
                    Margin="8,0" />
            <TextBlock Grid.Column="4"
                       Text="{Binding ShiftStatusText}"
                       Foreground="#FFD700"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="8,0" />
            <TextBlock Grid.Column="5"
                       Text="{Binding CurrentDateTime}"
                       Foreground="White"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="8,0,12,0" />
        </Grid>

        <TransitioningContentControl Grid.Row="1"
                                     Content="{Binding CurrentPage}"
                                     PageTransition="{Binding PageTransition}" />

        <Grid Grid.Row="2"
              Height="30"
              Background="{StaticResource BrandBrush}"
              ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       Foreground="White"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="12,0" />
            <Ellipse Grid.Column="1"
                     Width="16" Height="16"
                     Fill="#FF0000"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0" />
        </Grid>
    </Grid>
</UserControl>
