<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaVde.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:MenuViewModel"
             x:Class="AvaloniaVde.Views.MenuView">

    <UserControl.Styles>
        <Style Selector="Button.MenuButton">
            <Setter Property="Background" Value="#808080" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="MinHeight" Value="140" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
          RowDefinitions="Auto,Auto,Auto"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          ColumnSpacing="15" RowSpacing="15" Margin="20">
        <!-- Ряд 0 -->
        <Button Grid.Column="0" Grid.Row="0"
                Classes="MenuButton"
                Command="{Binding GoDayTaskCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/task.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="task"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Grid.Column="1" Grid.Row="0"
                Classes="MenuButton"
                Command="{Binding GoHomeCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/dosing.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="dosing"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Grid.Column="2" Grid.Row="0"
                Classes="MenuButton"
                Command="{Binding GoScalesCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/scale.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="scale"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Grid.Column="3" Grid.Row="0"
                Classes="MenuButton"
                Command="{Binding GoInfoCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/info.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="info"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Ряд 1 -->
        <Button Grid.Column="0" Grid.Row="1"
                Classes="MenuButton"
                Command="{Binding GoRecipesCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/recipes.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="recipes"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Grid.Column="1" Grid.Row="1"
                Classes="MenuButton"
                Command="{Binding GoIngredientsCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/ingredient.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="ingredient"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Grid.Column="2" Grid.Row="1"
                Classes="MenuButton"
                Command="{Binding GoUsersCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/users.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="users"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Grid.Column="3" Grid.Row="1"
                Classes="MenuButton"
                Command="{Binding GoImagesCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/image.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="image"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Ряд 2 -->
        <Button Grid.Column="0" Grid.Row="2"
                Classes="MenuButton"
                Command="{Binding GoStatisticsCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/arhive.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="arhive"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Grid.Column="1" Grid.Row="2"
                Classes="MenuButton"
                Command="{Binding GoCountersCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/cnt.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="cnt"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Grid.Column="2" Grid.Row="2"
                Classes="MenuButton"
                Command="{Binding GoUsbCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/usb.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="usb"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Grid.Column="3" Grid.Row="2"
                Classes="MenuButton"
                Command="{Binding GoSettingsCommand}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/setting.png"
                       Width="60" Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="setting"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
    </ScrollViewer>
</UserControl>
